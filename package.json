{
  "name": "terrierhelper---sfc-student-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval": "node --import tsx eval/run.ts",
    "check": "npm run typecheck && npm test && npm run eval && npm run build",
    "test:browser": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "vercel:build": "npm run db:migrate && npm run build",
    "test:runtime": "tsc api/handler.ts --outDir .runtime-check --noEmit false --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck --strict && node -e \"import('./.runtime-check/api/handler.js')\""
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
