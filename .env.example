GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional alternate model for transient 5xx retries; empty retries GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
DATABASE_PATH=data/terrier.sqlite
PORT=3000
# Production: set to the exact HTTPS origin, e.g. https://helper.example.com
# APP_ORIGIN=https://helper.example.com
# Set only if your deployment uses exactly this number of trusted proxy hops:
# TRUST_PROXY=1
# Vercel only: pooled PostgreSQL connection with pgvector support (server-side secret).
# DATABASE_URL=postgresql://...
# Vercel only: random secret of at least 32 characters for daily retention cleanup.
# CRON_SECRET=
