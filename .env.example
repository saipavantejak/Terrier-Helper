GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional alternate model for transient 5xx retries; empty retries GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
DATABASE_PATH=data/terrier.sqlite
PORT=3000
# Production: set to the exact HTTPS origin, e.g. https://helper.example.com
# APP_ORIGIN=https://helper.example.com
# Set only if your deployment uses exactly this number of trusted proxy hops:
# TRUST_PROXY=1
# Vercel only: pooled PostgreSQL connection with pgvector support (server-side secret).
# DATABASE_URL=postgresql://...
# Vercel only: random secret of at least 32 characters for daily retention cleanup.
# CRON_SECRET=

# College deployment and admin bootstrap (never use VITE_ for secrets).
INSTITUTION_ID=sfc-brooklyn
INSTITUTION_NAME=St. Francis College
INSTITUTION_LOCATION=Brooklyn, New York
INSTITUTION_WEBSITE=https://www.sfc.edu
# Generate at least 32 random characters; empty disables administrator sign-in.
ADMIN_ACCESS_KEY=
INSTITUTION_DOCUMENT_LIMIT=100
INSTITUTION_STORAGE_MB=80
TOTAL_STORAGE_MB=100
CHAT_HOURLY_LIMIT=100

# Reuse the same grounding engine across domains: college | tech | medical | general
ASSISTANT_DOMAIN=college
ASSISTANT_NAME=TerrierHelper
# Existing deployments use ADMIN_ACCESS_KEY as a fallback signing key.
# Prefer a separate generated secret (32+ characters) shared by API replicas.
FEEDBACK_SIGNING_KEY=
FEEDBACK_ENABLED=true
